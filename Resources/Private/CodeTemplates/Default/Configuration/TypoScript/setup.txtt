{namespace sav=YolfTypo3\SavLibraryKickstarter\ViewHelpers}<sav:utility.removeEmptyLines keepLine="!">

<f:alias map="{
    extensionName:  '{extension.general.1.extensionKey->sav:format.removeUnderscore()}'
}">

plugin.tx_{extensionName} {
    view {
        templateRootPaths.10 = <f:format.raw>{</f:format.raw>$plugin.tx_{extensionName}.view.templateRootPath<f:format.raw>}</f:format.raw>
        partialRootPaths.10 = <f:format.raw>{</f:format.raw>$plugin.tx_{extensionName}.view.partialRootPath<f:format.raw>}</f:format.raw>
        layoutRootPaths.10 = <f:format.raw>{</f:format.raw>$plugin.tx_{extensionName}.view.layoutRootPath<f:format.raw>}</f:format.raw>
    }
    persistence {
        storagePid = <f:format.raw>{</f:format.raw>$plugin.tx_{extensionName}.persistence.storagePid<f:format.raw>}</f:format.raw>
    }
}
</f:alias>
</sav:utility.removeEmptyLines>