{namespace sav=YolfTypo3\SavLibraryKickstarter\ViewHelpers}<sav:utility.removeEmptyLines keepLine="!">
<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>
                    LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.sheetTitle.sDEF</sheetTitle>
                <type>array</type>
                <el>
                    <helpGeneral>
                        <config>
                            <type>user</type>
                            <renderType>help</renderType>
                            <parameters>
                                <section>
                                    Configuration/FlexformAssociatedWithThePlugin</section>
                                <tag>
                                    flexformAssociatedWithThePlugin-generalFolder</tag>
                            </parameters>
                        </config>
                    </helpGeneral>
                    <settings.formId>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.formId</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <numIndex index="label"></numIndex>
                                    <numIndex index="value"></numIndex>
                                </numIndex>
                                <f:for each="{extension.forms}" as="form"
                                    key="formKey">
                                    <numIndex index="{formKey}" type="array">
                                        <numIndex index="label">{form.title}</numIndex>
                                        <numIndex index="value">{formKey}</numIndex>
                                    </numIndex>
                                </f:for>
                            </items>
                            <maxitems>1</maxitems>
                        </config>
                    </settings.formId>
                    <settings.noFilterShowAll>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.noFilterShowAll</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.noFilterShowAll>
                    <settings.showNoAvailableInformation>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.showNoAvailableInformation</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.showNoAvailableInformation.I.0</numIndex>
                                    <numIndex index="value">0</numIndex>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.showNoAvailableInformation.I.1</numIndex>
                                    <numIndex index="value">1</numIndex>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.showNoAvailableInformation.I.2</numIndex>
                                    <numIndex index="value">2</numIndex>
                                </numIndex>
                            </items>
                            <maxitems>1</maxitems>
                        </config>
                    </settings.showNoAvailableInformation>
                    <settings.maxItems>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.maxItems</label>
                        <config>
                            <type>input</type>
                            <eval>int</eval>
                            <size>2</size>
                            <default>10</default>
                        </config>
                    </settings.maxItems>
					<settings.storagePid>
						<label>
							LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.storagePage</label>
						<config>
							<type>group</type>
							<allowed>pages</allowed>
							<size>1</size>
							<maxitems>1</maxitems>
							<minitems>0</minitems>
						</config>
					</settings.storagePid> 
                </el>					                 
            </ROOT>
        </sDEF>
        <sInput>
            <ROOT>
                <sheetTitle>
                    LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.sheetTitle.sInput</sheetTitle>
                <type>array</type>
                <el>
                    <settings.helpInput>
                        <config>
                            <type>user</type>
                            <renderType>help</renderType>
                            <parameters>
                                <section>
                                    Configuration/FlexformAssociatedWithThePlugin</section>
                                <tag>
                                    flexformAssociatedWithThePlugin-generalFolder</tag>
                            </parameters>
                        </config>
                    </settings.helpInput>
                    <settings.inputIsAllowed>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.inputIsAllowed</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.inputIsAllowed>
                    <settings.allowedGroups>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.allowedGroups</label>
                        <config>
                            <type>group</type>
                            <allowed>fe_groups</allowed>
                            <size>3</size>
                            <maxitems>22</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.allowedGroups>
                    <settings.inputAdminField>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.inputAdminField</label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                        </config>
                    </settings.inputAdminField>
                    <settings.noNewButton>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.noNewButton</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.noNewButton>
                    <settings.noEditButton>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.noEditButton</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.noEditButton>
                    <settings.noDeleteButton>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.noDeleteButton</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.noDeleteButton>
                    <settings.deleteButtonOnlyForCruser>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.deleteButtonOnlyForCruser</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.deleteButtonOnlyForCruser>
                    <settings.inputStartDate>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.inputStartDate</label>
                        <config>
                            <type>datetime</type>
                            <format>date</format>
                            <size>20</size>
                            <default>0</default>
                        </config>
                    </settings.inputStartDate>
                    <settings.inputEndDate>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.inputEndDate</label>
                        <config>
                            <type>datetime</type>
                            <format>date</format>
                            <size>20</size>
                            <default>0</default>
                        </config>
                    </settings.inputEndDate>
                    <settings.inputApplyLimit>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.inputApplyLimit</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.inputApplyLimit.I.0</numIndex>
                                    <numIndex index="value">0</numIndex>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.inputApplyLimit.I.1</numIndex>
                                    <numIndex index="value">1</numIndex>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.inputApplyLimit.I.2</numIndex>
                                    <numIndex index="value">2</numIndex>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.inputApplyLimit.I.3</numIndex>
                                    <numIndex index="value">3</numIndex>
                                </numIndex>
                            </items>
                            <maxitems>1</maxitems>
                        </config>
                    </settings.inputApplyLimit>
                </el>
            </ROOT>
        </sInput>
        <sAdvanced>
            <ROOT>
                <sheetTitle>
                    LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.sheetTitle.sAdvanced</sheetTitle>
                <type>array</type>
                <el>
                    <helpAdvanced>
                        <config>
                            <type>user</type>
                            <renderType>help</renderType>
                            <parameters>
                                <section>
                                    Configuration/FlexformAssociatedWithThePlugin</section>
                                <tag>
                                    flexformAssociatedWithThePlugin-generalFolder</tag>
                            </parameters>
                        </config>
                    </helpAdvanced>
                    <settings.permanentFilter>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.permanentFilter</label>
                        <config>
                            <type>input</type>
                            <size>60</size>
                        </config>
                    </settings.permanentFilter>
                    <addFragment>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.addFragment</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </addFragment>
                    <settings.allowQueryProperty>
                        <exclude>1</exclude>
                        <displayCond>HIDE_FOR_NON_ADMINS</displayCond>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.allowQueryProperty</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.allowQueryProperty>
                    <settings.allowExec>
                        <displayCond>HIDE_FOR_NON_ADMINS</displayCond>
                        <label>
                            LLL:EXT:sav_library_mvc/Resources/Private/Language/locallang.xlf:extensionFlexform.allowExec</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.allowExec>
                </el>
            </ROOT>
        </sAdvanced>
    </sheets>
</T3DataStructure>
</sav:utility.removeEmptyLines>