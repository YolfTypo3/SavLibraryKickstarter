{namespace sav=YolfTypo3\SavLibraryKickstarter\ViewHelpers}<sav:utility.removeEmptyLines keepLine="!">
<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>
                    LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.sheetTitle.sDEF</sheetTitle>
                <type>array</type>
                <el>
                    <helpGeneral>
                        <config>
                            <type>user</type>
                            <renderType>help</renderType>
                            <parameters>
                                <section>
                                    Configuration/FlexformAssociatedWithThePlugin</section>
                                <tag>general-folder</tag>
                            </parameters>
                        </config>
                    </helpGeneral>
                    <formId>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.formId</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <numIndex index="label"></numIndex>
                                    <numIndex index="value"></numIndex>
                                </numIndex>
                                <f:for each="{extension.forms}" as="form"
                                    key="formKey">
                                    <numIndex index="{formKey}" type="array">
                                        <numIndex index="label">{form.title}</numIndex>
                                        <numIndex index="value">{formKey}</numIndex>
                                    </numIndex>
                                </f:for>
                            </items>
                            <maxitems>1</maxitems>
                        </config>
                    </formId>
                    <noFilterShowAll>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.noFilterShowAll</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </noFilterShowAll>
                    <showNoAvailableInformation>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.showNoAvailableInformation</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.showNoAvailableInformation.I.0</numIndex>
                                    <numIndex index="value"></numIndex>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.showNoAvailableInformation.I.1</numIndex>
                                    <numIndex index="value">1</numIndex>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.showNoAvailableInformation.I.2</numIndex>
                                    <numIndex index="value">2</numIndex>
                                </numIndex>
                            </items>
                            <maxitems>1</maxitems>
                        </config>
                    </showNoAvailableInformation>
                    <maxItems>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.maxItems</label>
                        <config>
                            <type>input</type>
                            <eval>int</eval>
                            <size>2</size>
                            <default>10</default>
                        </config>
                    </maxItems>
					<storagePage>
						<label>
							LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.storagePage</label>
						<config>
							<type>group</type>
							<allowed>pages</allowed>
							<size>1</size>
							<maxitems>1</maxitems>
							<minitems>0</minitems>
						</config>
					</storagePage>                      
                </el>
            </ROOT>
        </sDEF>
        <sInput>
            <ROOT>
                <sheetTitle>
                    LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.sheetTitle.sInput</sheetTitle>
                <type>array</type>
                <el>
                    <helpInputControls>
                        <config>
                            <type>user</type>
                            <renderType>help</renderType>
                            <parameters>
                                <section>
                                    Configuration/FlexformAssociatedWithThePlugin</section>
                                <tag>input-controls-folder</tag>
                            </parameters>
                        </config>
                    </helpInputControls>
                    <inputIsAllowed>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.inputIsAllowed</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </inputIsAllowed>
                    <allowedGroups>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.allowedGroups</label>
                        <config>
                            <type>group</type>
                            <allowed>fe_groups</allowed>
                            <size>3</size>
                            <maxitems>22</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </allowedGroups>
                    <inputAdminField>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.inputAdminField</label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                        </config>
                    </inputAdminField>
                    <noNewButton>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.noNewButton</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </noNewButton>
                    <noEditButton>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.noEditButton</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </noEditButton>
                    <noDeleteButton>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.noDeleteButton</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </noDeleteButton>
                    <deleteButtonOnlyForCreationUser>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.deleteButtonOnlyForCreationUser</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </deleteButtonOnlyForCreationUser>
                    <inputStartDate>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.inputStartDate</label>
                        <config>
                            <type>datetime</type>
                            <format>date</format>
                            <size>20</size>
                            <default>0</default>
                        </config>
                    </inputStartDate>
                    <inputEndDate>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.inputEndDate</label>
                        <config>
                            <type>datetime</type>
                            <format>date</format>
                            <size>20</size>
                            <default>0</default>
                        </config>
                    </inputEndDate>
                    <dateUserRestriction>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.dateUserRestriction</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.dateUserRestriction.I.0</numIndex>
                                    <numIndex index="value"></numIndex>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.dateUserRestriction.I.1</numIndex>
                                    <numIndex index="value">1</numIndex>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.dateUserRestriction.I.2</numIndex>
                                    <numIndex index="value">2</numIndex>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <numIndex index="label">
                                        LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.dateUserRestriction.I.3</numIndex>
                                    <numIndex index="value">3</numIndex>
                                </numIndex>
                            </items>
                            <maxitems>1</maxitems>
                        </config>
                    </dateUserRestriction>
                </el>
            </ROOT>
        </sInput>
        <sAdvanced>
            <ROOT>
                <sheetTitle>
                    LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.sheetTitle.sAdvanced</sheetTitle>
                <type>array</type>
                <el>
                    <helpAdvanced>
                        <config>
                            <type>user</type>
                            <renderType>help</renderType>
                            <parameters>
                                <section>
                                    Configuration/FlexformAssociatedWithThePlugin</section>
                                <tag>advanced-folder</tag>
                            </parameters>
                        </config>
                    </helpAdvanced>
                    <permanentFilter>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.permanentFilter</label>
                        <config>
                            <type>input</type>
                            <size>60</size>
                        </config>
                    </permanentFilter>
                    <addFragment>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.addFragment</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </addFragment>
                    <allowDisplayDataQuery>
                        <displayCond>HIDE_FOR_NON_ADMINS</displayCond>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.allowDisplayDataQuery</label>
                        <config>
                            <type>text</type>
                            <cols>80</cols>
                            <rows>8</rows>
                        </config>
                    </allowDisplayDataQuery>
                    <allowQueryProperty>
                        <displayCond>HIDE_FOR_NON_ADMINS</displayCond>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.allowQueryProperty</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </allowQueryProperty>
                    <allowExec>
                        <displayCond>HIDE_FOR_NON_ADMINS</displayCond>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.allowExec</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </allowExec>
                </el>
            </ROOT>
        </sAdvanced>
        <sHelpPages>
            <ROOT>
                <sheetTitle>
                    LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.sheetTitle.sHelpPages</sheetTitle>
                <type>array</type>
                <el>
                    <helpHelpPages>
                        <config>
                            <type>user</type>
                            <renderType>help</renderType>
                            <parameters>
                                <section>
                                    Configuration/FlexformAssociatedWithThePlugin</section>
                                <tag>help-pages-folder</tag>
                            </parameters>
                        </config>
                    </helpHelpPages>
                    <helpPageListView>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.helpPageListView</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </helpPageListView>
                    <helpPageSingleView>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.helpPageSingleView</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </helpPageSingleView>
                    <helpPageEditView>
                        <label>
                            LLL:EXT:sav_library_plus/Resources/Private/Language/locallang.xlf:pi_flexform.helpPageEditView</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </helpPageEditView>
                </el>
            </ROOT>
        </sHelpPages>
    </sheets>
</T3DataStructure>
</sav:utility.removeEmptyLines>